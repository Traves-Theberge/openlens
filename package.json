{
  "name": "openlens",
  "version": "0.2.4",
  "description": "AI-powered code review using specialized agents",
  "type": "module",
  "bin": {
    "openlens": "./dist/index.js"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "agents",
    "action.yml",
    "plugins",
    "wiki",
    "hooks",
    "skills"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "code-review",
    "ai",
    "opencode",
    "linter",
    "sarif",
    "cli"
  ],
  "license": "MIT",
  "author": "Traves Theberge",
  "repository": {
    "type": "git",
    "url": "https://github.com/Traves-Theberge/openlens.git"
  },
  "homepage": "https://github.com/Traves-Theberge/openlens",
  "bugs": {
    "url": "https://github.com/Traves-Theberge/openlens/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@hono/node-server": "^1.19.17",
    "@opencode-ai/plugin": "^1.19.4",
    "@opencode-ai/sdk": "^1.19.4",
    "@opencode/cli": "^2.1.4",
    "@opencode/client": "^2.1.4",
    "@opencode/plugin": "^2.1.4",
    "@opencode/sdk": "^2.1.4",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.13",
    "opencode-ai": "^1.19.4",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/yargs": "^17.0.35",
    "bun-types": "^1.4.4",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@opencode/cli"
  ]
}
